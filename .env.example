# ---------------------------------------------------------------------------
# DevCollab environment. Copy to .env and fill in. Only the first two are
# REQUIRED - the app boots and runs fully without Cloudinary or Gemini.
# ---------------------------------------------------------------------------

# REQUIRED. MongoDB Atlas connection string, including the database name.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/devcollab?retryWrites=true&w=majority

# REQUIRED. Any long random string. Signs the auth JWT.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. 'production' makes Express serve client/dist and sets secure cookies.
NODE_ENV=development

# Optional. Render injects its own PORT; locally we default to 5000.
PORT=5000

# Optional. Only used by server/utils/smoke.js to know where to send requests.
SMOKE_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# OPTIONAL: Cloudinary image uploads.
# If CLOUDINARY_CLOUD_NAME is absent the API accepts a plain image URL string
# instead and the client swaps the file picker for a URL text field.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL: Google Gemini, for AI-drafted project descriptions.
# If absent, POST /api/ai/describe returns 503 and the client hides the button.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
