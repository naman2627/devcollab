{
  "name": "devcollab",
  "version": "1.0.0",
  "private": true,
  "description": "DevCollab - post side projects, recruit collaborators. MERN single-service app.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm install --prefix client && npm --prefix client run build",
    "start": "node server/server.js",
    "seed": "node server/utils/seed.js",
    "smoke": "node server/utils/smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7"
  }
}
